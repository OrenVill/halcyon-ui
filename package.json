{
  "name": "halcyon-ui",
  "version": "0.0.0",
  "description": "A lightweight, themeable, accessible React component library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrenVill/halcyon-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./display": {
      "types": "./dist/display.d.ts",
      "import": "./dist/display.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./structures": {
      "types": "./dist/structures.d.ts",
      "import": "./dist/structures.js"
    },
    "./structures/navbar": {
      "types": "./dist/structures/navbar.d.ts",
      "import": "./dist/structures/navbar.js"
    },
    "./structures/sidebar": {
      "types": "./dist/structures/sidebar.d.ts",
      "import": "./dist/structures/sidebar.js"
    },
    "./structures/form-layout": {
      "types": "./dist/structures/form-layout.d.ts",
      "import": "./dist/structures/form-layout.js"
    },
    "./structures/app-shell": {
      "types": "./dist/structures/app-shell.d.ts",
      "import": "./dist/structures/app-shell.js"
    },
    "./structures/dashboard-layout": {
      "types": "./dist/structures/dashboard-layout.d.ts",
      "import": "./dist/structures/dashboard-layout.js"
    },
    "./structures/docs-site": {
      "types": "./dist/structures/docs-site.d.ts",
      "import": "./dist/structures/docs-site.js"
    },
    "./structures/marketing-site": {
      "types": "./dist/structures/marketing-site.d.ts",
      "import": "./dist/structures/marketing-site.js"
    },
    "./structures/login-layout": {
      "types": "./dist/structures/login-layout.d.ts",
      "import": "./dist/structures/login-layout.js"
    },
    "./structures/signup-layout": {
      "types": "./dist/structures/signup-layout.d.ts",
      "import": "./dist/structures/signup-layout.js"
    },
    "./structures/forgot-password-layout": {
      "types": "./dist/structures/forgot-password-layout.d.ts",
      "import": "./dist/structures/forgot-password-layout.js"
    },
    "./structures/error-page": {
      "types": "./dist/structures/error-page.d.ts",
      "import": "./dist/structures/error-page.js"
    },
    "./structures/blog": {
      "types": "./dist/structures/blog.d.ts",
      "import": "./dist/structures/blog.js"
    },
    "./structures/settings-layout": {
      "types": "./dist/structures/settings-layout.d.ts",
      "import": "./dist/structures/settings-layout.js"
    },
    "./structures/onboarding-layout": {
      "types": "./dist/structures/onboarding-layout.d.ts",
      "import": "./dist/structures/onboarding-layout.js"
    },
    "./structures/checkout-layout": {
      "types": "./dist/structures/checkout-layout.d.ts",
      "import": "./dist/structures/checkout-layout.js"
    },
    "./websites": {
      "types": "./dist/websites.d.ts",
      "import": "./dist/websites.js"
    },
    "./websites/marketing": {
      "types": "./dist/websites/marketing.d.ts",
      "import": "./dist/websites/marketing.js"
    },
    "./websites/saas": {
      "types": "./dist/websites/saas.d.ts",
      "import": "./dist/websites/saas.js"
    },
    "./websites/docs": {
      "types": "./dist/websites/docs.d.ts",
      "import": "./dist/websites/docs.js"
    },
    "./websites/commerce": {
      "types": "./dist/websites/commerce.d.ts",
      "import": "./dist/websites/commerce.js"
    },
    "./base": "./dist/base.css",
    "./midnight": "./dist/midnight.css",
    "./aurora": "./dist/aurora.css",
    "./ember": "./dist/ember.css",
    "./forest": "./dist/forest.css",
    "./sandstone": "./dist/sandstone.css",
    "./mono": "./dist/mono.css",
    "./neon": "./dist/neon.css"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "tsx scripts/build-css.ts",
    "gallery": "tsx scripts/build-gallery.ts",
    "api": "tsx scripts/print-public-api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:size": "tsx scripts/check-size.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:css": "tsx scripts/check-css.ts"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
